{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tyroneross/persona-lab/schemas/run.schema.json",
  "title": "Persona run",
  "description": "One persona panel as a durable object. personas.json holds who a persona is; encounters/ holds what one persona saw in one sitting; a run holds what happened in the panel \u2014 the roster, the frozen artifact, the lanes in order, and what nobody could settle.",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "request",
    "artifact",
    "roster",
    "status",
    "started_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1.0.0"
      ]
    },
    "run_id": {
      "type": "string"
    },
    "request": {
      "type": "string",
      "description": "One sentence on what the panel was asked to judge."
    },
    "artifact": {
      "type": "object",
      "required": [
        "slug",
        "label",
        "frozen"
      ],
      "properties": {
        "slug": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "frozen": {
          "type": "boolean",
          "const": true,
          "description": "Always true. A panel that races builder edits produces findings about something that never existed."
        },
        "project": {
          "type": "string",
          "description": "Project or category this artifact belongs to. Lets a persona with recall scope \"project\" carry context across artifacts in the same ongoing effort."
        },
        "sha256": {
          "type": "string"
        },
        "manifest": {
          "type": "object"
        },
        "integrity": {
          "type": "string",
          "enum": [
            "snapshot",
            "declared"
          ]
        }
      }
    },
    "roster": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "description": "persona_ids on the panel."
    },
    "level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "lanes": {
      "type": "array",
      "description": "Passes in the order they ran. A debate lane may never precede a blind lane.",
      "items": {
        "type": "object",
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "blind",
              "debate",
              "adjudication"
            ]
          },
          "encounter_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "synthesis": {
      "type": "string"
    },
    "unanswered": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Pooled from every encounter at close. This is the next dispatch's agenda, because there is no second turn."
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "closed",
        "abandoned"
      ]
    },
    "started_at": {
      "type": "string"
    },
    "ended_at": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "study": {
      "type": "object",
      "required": ["objective", "target_concepts", "tasks", "questions"],
      "properties": {
        "objective": { "type": "string" },
        "target_concepts": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "tasks": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "instruction"], "properties": { "id": { "type": "string" }, "instruction": { "type": "string" } } } },
        "questions": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "prompt", "type", "expected_concepts", "max_score", "rubric"], "properties": { "id": { "type": "string" }, "prompt": { "type": "string" }, "type": { "type": "string", "enum": ["recall", "relationship", "transfer", "boundary"] }, "expected_concepts": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "max_score": { "type": "number" }, "rubric": { "type": "string" } } } }
      }
    },
    "outcome": {
      "type": "object",
      "description": "What this panel actually produced, recorded after the fact. A lesson about the run, never a reconstruction of what a persona saw \u2014 the encounters are the only record of that.",
      "required": [
        "verdict",
        "recorded_at"
      ],
      "properties": {
        "verdict": {
          "type": "string",
          "enum": [
            "valuable",
            "mixed",
            "wasted"
          ],
          "description": "valuable \u2014 it changed the artifact or a decision. mixed \u2014 some signal, high cost. wasted \u2014 nothing changed as a result."
        },
        "what_changed": {
          "type": "string",
          "description": "What actually changed because of this panel. If nothing, say nothing \u2014 that is the finding."
        },
        "landed": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Finding claims that led to a real change."
        },
        "method_worked": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "What about the METHOD worked \u2014 composition, framing, ordering, question design."
        },
        "method_failed": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "What about the method broke."
        },
        "reuse_roster": {
          "type": "boolean",
          "description": "Whether this roster is worth running again."
        },
        "recorded_at": {
          "type": "string"
        }
      }
    }
  }
}
