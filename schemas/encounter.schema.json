{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://persona-lab/schemas/encounter.schema.json",
  "title": "Persona encounter",
  "description": "One session in which a persona met an artifact. Written by the persona before it returns, so the record survives the session that produced it. A persona's continuity lives in these files, never in a live agent process.",
  "type": "object",
  "required": [
    "schema_version",
    "encounter_id",
    "persona_id",
    "artifact",
    "started_at",
    "blind",
    "verbatim",
    "conditions"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1.0.0"
      ]
    },
    "encounter_id": {
      "type": "string",
      "description": "Stable id, convention <persona_id>--<artifact.slug>--<YYYY-MM-DD>--<n>"
    },
    "persona_id": {
      "type": "string",
      "description": "Foreign key into personas.json. The identity lives there, not here."
    },
    "artifact": {
      "type": "object",
      "required": [
        "slug",
        "label"
      ],
      "additionalProperties": false,
      "properties": {
        "slug": {
          "type": "string",
          "description": "Stable across versions, so encounters can be compared over time"
        },
        "label": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "description": "Commit, build hash, or snapshot name. Required to compare rounds honestly."
        },
        "frozen": {
          "type": "boolean",
          "description": "True when the artifact was snapshotted so edits could not race the session"
        },
        "project": {
          "type": "string",
          "description": "Project or category this artifact belongs to. Lets a persona with recall scope \"project\" carry context across artifacts in the same ongoing effort."
        },
        "sha256": {
          "type": "string"
        }
      }
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time"
    },
    "blind": {
      "type": "boolean",
      "description": "True when the persona was given no prior encounter of its own. Blind reads avoid anchoring; informed reads answer whether something improved. Never mix them silently."
    },
    "prior_encounters_shown": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "encounter_ids the persona was allowed to read. Empty when blind."
    },
    "conditions": {
      "type": "object",
      "required": [
        "viewports"
      ],
      "additionalProperties": false,
      "properties": {
        "viewports": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "e.g. 390x844, 1440x900. Findings are meaningless without this."
        },
        "driver": {
          "type": "string",
          "description": "How the artifact was operated, e.g. a real browser session"
        },
        "time_budget": {
          "type": "string",
          "description": "Stated constraint the persona worked under, e.g. four minutes"
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "navigate": { "type": "object", "additionalProperties": false, "required": ["provider", "status"], "properties": { "provider": { "type": "string", "enum": ["computer-use", "ibr", "spectra", "screenshot"] }, "status": { "type": "string", "enum": ["unverified", "available", "unavailable"] }, "evidence": { "type": "string", "pattern": "^(cua|ibr|spectra|screenshot|file|session):" }, "attestation": { "type": "string", "enum": ["host-observed"] }, "observed_at": { "type": "string" } } },
            "interact": { "type": "object", "additionalProperties": false, "required": ["provider", "status"], "properties": { "provider": { "type": "string", "enum": ["computer-use", "ibr", "spectra", "screenshot"] }, "status": { "type": "string", "enum": ["unverified", "available", "unavailable"] }, "evidence": { "type": "string", "pattern": "^(cua|ibr|spectra|screenshot|file|session):" }, "attestation": { "type": "string", "enum": ["host-observed"] }, "observed_at": { "type": "string" } } },
            "inspect": { "type": "object", "additionalProperties": false, "required": ["provider", "status"], "properties": { "provider": { "type": "string", "enum": ["computer-use", "ibr", "spectra", "screenshot"] }, "status": { "type": "string", "enum": ["unverified", "available", "unavailable"] }, "evidence": { "type": "string", "pattern": "^(cua|ibr|spectra|screenshot|file|session):" }, "attestation": { "type": "string", "enum": ["host-observed"] }, "observed_at": { "type": "string" } } },
            "viewport": { "type": "object", "additionalProperties": false, "required": ["provider", "status"], "properties": { "provider": { "type": "string", "enum": ["computer-use", "ibr", "spectra", "screenshot"] }, "status": { "type": "string", "enum": ["unverified", "available", "unavailable"] }, "evidence": { "type": "string", "pattern": "^(cua|ibr|spectra|screenshot|file|session):" }, "attestation": { "type": "string", "enum": ["host-observed"] }, "observed_at": { "type": "string" } } },
            "snapshot": { "type": "object", "additionalProperties": false, "required": ["provider", "status"], "properties": { "provider": { "type": "string", "enum": ["computer-use", "ibr", "spectra", "screenshot"] }, "status": { "type": "string", "enum": ["unverified", "available", "unavailable"] }, "evidence": { "type": "string", "pattern": "^(cua|ibr|spectra|screenshot|file|session):" }, "attestation": { "type": "string", "enum": ["host-observed"] }, "observed_at": { "type": "string" } } },
            "record": { "type": "object", "additionalProperties": false, "required": ["provider", "status"], "properties": { "provider": { "type": "string", "enum": ["computer-use", "ibr", "spectra", "screenshot"] }, "status": { "type": "string", "enum": ["unverified", "available", "unavailable"] }, "evidence": { "type": "string", "pattern": "^(cua|ibr|spectra|screenshot|file|session):" }, "attestation": { "type": "string", "enum": ["host-observed"] }, "observed_at": { "type": "string" } } }
          }
        }
      }
    },
    "verbatim": {
      "type": "string",
      "description": "The persona's unedited report. Never summarise here. Synthesis belongs in a separate file so this stays checkable."
    },
    "findings": {
      "type": "array",
      "description": "Structured claims extracted from the verbatim report. Extraction is lossy, so verbatim remains authoritative.",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "claim"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "defect",
              "confusion",
              "praise",
              "preference",
              "request"
            ],
            "description": "A defect is something that does not work. A preference is dislike of something that works. Conflating them is the most common analysis error."
          },
          "claim": {
            "type": "string"
          },
          "quote": {
            "type": "string",
            "description": "The exact phrase, where the persona gave one"
          },
          "locus": {
            "type": "string",
            "description": "Section, control, or element the finding attaches to"
          },
          "viewport": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "blocking",
              "major",
              "minor",
              "cosmetic"
            ]
          },
          "verified": {
            "type": "string",
            "enum": [
              "unverified",
              "confirmed",
              "refuted",
              "reclassified"
            ],
            "description": "Set by a reviewer who checked the claim against the artifact. A reported defect that turns out to be a silent gate is reclassified, not confirmed."
          },
          "verification_note": {
            "type": "string"
          },
          "finding_id": {
            "type": "string"
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "description": "Choices the persona made while working, recorded so a later session can see how it behaved rather than only what it concluded.",
      "items": {
        "type": "object",
        "required": [
          "action",
          "rationale"
        ],
        "additionalProperties": false,
        "properties": {
          "action": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          },
          "gave_up": {
            "type": "boolean",
            "description": "True where the persona abandoned a path. Abandonment is a finding."
          }
        }
      }
    },
    "unanswered": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Questions this encounter raised and could not settle. Ask these up front next time, since a follow-up turn is not reliably available."
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "understood_purpose": {
          "type": "boolean",
          "description": "Could the persona say what the thing does, in its own words"
        },
        "would_recommend": {
          "type": "boolean"
        },
        "score": {
          "type": "number",
          "description": "Only where the persona was asked for one. Do not synthesise a score."
        },
        "verdict": {
          "type": "string",
          "enum": [
            "succeeds",
            "partly",
            "fails"
          ]
        }
      }
    },
    "journey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goal", "completed", "actions", "snapshots"],
      "properties": {
        "goal": { "type": "string" },
        "completed": { "type": "boolean" },
        "stop_reason": { "type": "string" },
        "actions": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["sequence", "action", "rationale", "result"], "properties": { "sequence": { "type": "number" }, "action": { "type": "string" }, "rationale": { "type": "string" }, "result": { "type": "string" }, "url": { "type": "string" } } } },
        "snapshots": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["snapshot_id", "label", "locator", "viewport", "observed"], "properties": { "snapshot_id": { "type": "string" }, "label": { "type": "string" }, "locator": { "type": "string" }, "viewport": { "type": "string" }, "observed": { "type": "string" } } } }
      }
    },
    "comprehension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "answers"],
      "properties": {
        "mode": { "type": "string", "enum": ["procedural-closed-book"] },
        "answers": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["question_id", "answer"], "properties": { "question_id": { "type": "string" }, "answer": { "type": "string" }, "confidence": { "type": ["number", "null"] } } } },
        "assessment": { "type": "object", "additionalProperties": false, "required": ["assessor", "items", "total_score", "max_score", "percent"], "properties": { "assessor": { "type": "string" }, "items": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["question_id", "score", "max_score", "rationale", "concepts_present", "misconceptions"], "properties": { "question_id": { "type": "string" }, "score": { "type": "number" }, "max_score": { "type": "number" }, "rationale": { "type": "string" }, "concepts_present": { "type": "array", "items": { "type": "string" } }, "misconceptions": { "type": "array", "items": { "type": "string" } } } } }, "total_score": { "type": "number" }, "max_score": { "type": "number" }, "percent": { "type": "number" } } }
      }
    },
    "run_id": {
      "type": "string",
      "description": "The persona run (panel) this encounter belonged to. Lets a run resolve its encounters and a persona resolve every panel it sat on."
    },
    "unlinked_run_id": {
      "type": "string"
    },
    "unlinked_reason": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": { "required": ["journey"], "properties": { "journey": { "type": "object", "required": ["completed"], "properties": { "completed": { "const": true } } } } },
      "then": {
        "properties": {
          "conditions": {
            "required": ["capabilities"],
            "properties": {
              "capabilities": {
                "required": ["navigate", "interact", "inspect", "viewport", "snapshot"],
                "properties": {
                  "navigate": { "required": ["provider", "status", "evidence", "attestation", "observed_at"], "properties": { "status": { "const": "available" } } },
                  "interact": { "required": ["provider", "status", "evidence", "attestation", "observed_at"], "properties": { "status": { "const": "available" } } },
                  "inspect": { "required": ["provider", "status", "evidence", "attestation", "observed_at"], "properties": { "status": { "const": "available" } } },
                  "viewport": { "required": ["provider", "status", "evidence", "attestation", "observed_at"], "properties": { "status": { "const": "available" } } },
                  "snapshot": { "required": ["provider", "status", "evidence", "attestation", "observed_at"], "properties": { "status": { "const": "available" } } }
                }
              }
            }
          },
          "journey": {
            "properties": {
              "actions": { "minItems": 1 },
              "snapshots": { "minItems": 1 }
            }
          },
          "comprehension": {
            "required": ["answers"],
            "properties": { "answers": { "minItems": 1, "items": { "type": "object", "required": ["question_id", "answer"], "properties": { "answer": { "type": "string", "pattern": "\\S" } } } } }
          }
        }
      }
    }
  ]
}
