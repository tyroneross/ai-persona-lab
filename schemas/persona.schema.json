{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-user-personas.local/schemas/persona.schema.json",
  "title": "AI User Persona",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "status",
    "name",
    "archetype",
    "role",
    "summary",
    "primary_goal",
    "goals",
    "frustrations",
    "motivations",
    "behaviors",
    "needs",
    "scenarios",
    "evidence",
    "confidence",
    "tags",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1.0.0",
        "1.1.0"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^persona_[a-z0-9][a-z0-9-]*_[a-f0-9]{8}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "archived"
      ]
    },
    "name": {
      "$ref": "#/$defs/non_empty_string"
    },
    "archetype": {
      "$ref": "#/$defs/non_empty_string"
    },
    "composition": {
      "$ref": "#/$defs/composition"
    },
    "role": {
      "$ref": "#/$defs/non_empty_string"
    },
    "summary": {
      "type": "string",
      "minLength": 40,
      "maxLength": 600
    },
    "primary_goal": {
      "$ref": "#/$defs/non_empty_string"
    },
    "job_to_be_done": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400,
      "description": "JTBD job-story: When [situation], I want to [motivation], so I can [outcome]."
    },
    "goals": {
      "$ref": "#/$defs/non_empty_string_list"
    },
    "anti_goals": {
      "$ref": "#/$defs/non_empty_string_list",
      "description": "What would make this persona abandon or distrust the product."
    },
    "provenance": {
      "type": "string",
      "enum": [
        "proto",
        "qualitative",
        "synthetic-grounded",
        "synthetic-assumed"
      ],
      "description": "Basis for this persona: proto (team assumptions), qualitative (interviews), synthetic-grounded (LLM grounded in real data), synthetic-assumed (LLM assumption, hypothesis only)."
    },
    "frustrations": {
      "$ref": "#/$defs/non_empty_string_list"
    },
    "motivations": {
      "$ref": "#/$defs/non_empty_string_list"
    },
    "behaviors": {
      "$ref": "#/$defs/non_empty_string_list"
    },
    "needs": {
      "$ref": "#/$defs/non_empty_string_list"
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scenario"
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidence_item"
      }
    },
    "confidence": {
      "$ref": "#/$defs/confidence"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40
      },
      "uniqueItems": true,
      "default": []
    },
    "quote": {
      "type": "string",
      "minLength": 1,
      "maxLength": 280
    },
    "channels": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/non_empty_string"
      },
      "uniqueItems": true,
      "default": []
    },
    "tech_comfort": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "decision_style": {
      "type": "string",
      "enum": [
        "fast",
        "deliberate",
        "consensus",
        "authority-led"
      ]
    },
    "notes": {
      "type": "string",
      "maxLength": 2000
    },
    "created_at": {
      "$ref": "#/$defs/iso_datetime"
    },
    "updated_at": {
      "$ref": "#/$defs/iso_datetime"
    },
    "lifespan": {
      "type": "string",
      "enum": [
        "persistent",
        "temporary"
      ],
      "default": "persistent",
      "description": "persistent \u2014 lives in the library, reusable, accumulates history. temporary \u2014 exists for one run only, stored in that run's folder and never added to personas.json."
    },
    "recall": {
      "type": "string",
      "enum": [
        "none",
        "artifact",
        "project",
        "all"
      ],
      "default": "none",
      "description": "How much of its OWN history this persona may READ when dispatched. none = always fresh (a first impression is non-renewable). artifact = only prior encounters with the same artifact, i.e. the same problem still ongoing. project = across artifacts in the same project or category. all = everything. Writing is never gated by this; only reading."
    },
    "assists_with": {
      "type": "array",
      "description": "Areas this persona can credibly assist with, derived from the reviewed source principles attached to it. A claim about coverage, never about validated competence. Optional: a persona saved before the guest registry existed stays valid without it.",
      "maxItems": 24,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 40, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
    },
    "informed_by": {
      "type": "array",
      "description": "Reviewed-source guests whose principles were attached to this persona. Indexes a public transcript; never endorsement, never a claim the guest reviewed anything, never a licence to impersonate.",
      "items": { "$ref": "#/$defs/informed_by_entry" }
    }
  },
  "$defs": {
    "informed_by_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["guest_slug", "name", "principle_ids"],
      "properties": {
        "guest_slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "name": { "type": "string", "minLength": 1 },
        "principle_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "archetype_ids", "specialty_paths", "evidence_ids"],
      "description": "Optional overlapping archetypes and open-ended specialty paths. Application validation also requires evidence_ids to reference this persona's evidence records.",
      "properties": {
        "version": { "type": "string", "const": "1" },
        "archetype_ids": {
          "type": "array", "minItems": 1,
          "items": { "$ref": "#/$defs/composition_slug" }
        },
        "specialty_paths": {
          "type": "array",
          "items": {
            "type": "array", "minItems": 1,
            "items": { "$ref": "#/$defs/composition_slug" }
          }
        },
        "evidence_ids": {
          "type": "array",
          "items": { "type": "string", "pattern": "^evidence_[a-z0-9][a-z0-9-]*_[a-f0-9]{8}$" }
        }
      }
    },
    "composition_slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "non_empty_string_list": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "iso_datetime": {
      "type": "string",
      "format": "date-time"
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "description"
      ],
      "properties": {
        "title": {
          "$ref": "#/$defs/non_empty_string"
        },
        "description": {
          "type": "string",
          "minLength": 20,
          "maxLength": 600
        }
      }
    },
    "evidence_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_type",
        "summary",
        "confidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^evidence_[a-z0-9][a-z0-9-]*_[a-f0-9]{8}$"
        },
        "source_type": {
          "type": "string",
          "enum": [
            "interview",
            "survey",
            "analytics",
            "support",
            "sales",
            "desk_research",
            "synthetic"
          ]
        },
        "title": {
          "$ref": "#/$defs/non_empty_string"
        },
        "source_uri": {
          "type": "string",
          "minLength": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "summary": {
          "type": "string",
          "minLength": 20,
          "maxLength": 800
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "observed_at": {
          "$ref": "#/$defs/iso_datetime"
        }
      }
    }
  }
}
