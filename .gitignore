node_modules/
.DS_Store
*.log
__pycache__/
*.pyc

# Study internals belonging to other projects. Archived to build-loop-memory
# (atomize-ai + ross-labs-astro lanes). This repo is public; they are not.
encounters/**/engine/
encounters/**/rosslabs-integration-plan.md
.build-loop/
.procedural/*.lock
# Session continuity for the bookmark plugin. Holds working notes and paths from
# whoever last worked here; this repo is public, so it stays untracked.
.bookmark/

# Internal working documents are archived before removal; current product docs stay public.
docs/research/*-audit.md
docs/research/*-mining.md
docs/research/*-result.md
docs/PROPOSAL-*.md
apps/web/docs/plans/
apps/web/docs/rally-dogfood-plan.md
apps/web/src/UI_PLAN.md

# Rally runtime state — only manifest.json ships (mirrors agent-rally-point convention)
.rally/*
!.rally/manifest.json

# Design walk evidence. The emitted token file and the two before/after IBR
# summaries are the committed record; raw scans, screenshots and the interview
# transcript stay local.
apps/web/.designdoc/evidence/
apps/web/.designdoc/color-session.json
apps/web/.designdoc/.designer-state.json
apps/web/.designdoc/.visual-bootstrap.json
