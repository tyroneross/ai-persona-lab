{
  "version": "1",
  "policy": "Overlapping professional archetypes; specialty paths are open and composable, not exhaustive or exclusive. Defaults are navigation choices, not a validated optimum.",
  "archetypes": [
    {
      "id": "consultant",
      "name": "Consultant",
      "lens": "strategy",
      "default": true,
      "keywords": [
        "consultant",
        "plan",
        "recommend",
        "decision"
      ],
      "goal": "Turn an ambiguous brief into a decision, alternatives and a testable work plan.",
      "practices": [
        "Frame the decision and missing context",
        "Compare feasible alternatives",
        "Name assumptions and next evidence"
      ],
      "failure": "Advice without a decision owner or completion condition",
      "specialty_examples": [
        [
          "strategy"
        ],
        [
          "operating-model"
        ],
        [
          "ui-ux-orchestration"
        ]
      ]
    },
