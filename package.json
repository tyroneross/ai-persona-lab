{
  "name": "@tyroneross/persona-lab",
  "version": "0.7.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tyroneross/ai-persona-lab.git"
  },
  "description": "Launch synthetic personas to review your app UI/UX, architecture, and code base before you deploy",
  "type": "module",
  "bin": {
    "persona": "bin/persona.mjs"
  },
  "files": [
    "bin",
    "lib",
    "commands",
    "agents",
    "skills",
    "scripts",
    "!scripts/**/__pycache__/**",
    "!scripts/**/*.pyc",
    "schemas",
    "docs/archetypes.md",
    "README.md",
    "docs/installation.md",
    "docs/cli.md",
    "docs/LIMITATIONS.md",
    "docs/persona-memory.md",
    "docs/review-workspace.md",
    "AGENTS.md",
    "modules/decision-studio",
    "!modules/**/__pycache__/**",
    "!modules/**/*.pyc"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "web:install": "npm --prefix apps/web ci",
    "web:dev": "npm --prefix apps/web run dev",
    "web:build": "npm --prefix apps/web run build",
    "web:start": "npm --prefix apps/web run start",
    "web:typecheck": "npm --prefix apps/web run typecheck",
    "web:smoke": "node scripts/web-smoke.mjs"
  },
  "keywords": [
    "personas",
    "ui-review",
    "ux",
    "product",
    "research",
    "evaluation",
    "cli"
  ],
  "author": {
    "name": "Tyrone Ross"
  },
  "license": "Apache-2.0"
}
